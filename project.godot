; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SquadFormation-companyofheroes"
run/main_scene="res://Scenes/Levels/TestLevel.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DebugDraw="*res://Scripts/Debug/DebugDraw.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[dotnet]

project/assembly_name="SquadFormation-companyofheroes"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Soldiers"
3d_physics/layer_3="TerrainZones"
3d_physics/layer_4="Obstacles"

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.1

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
